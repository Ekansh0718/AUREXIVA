# Copy this file to .env and fill in your Supabase project's values.
# Find these under Project Settings > API in the Supabase dashboard.
# Never commit the real .env file.

VITE_SUPABASE_URL=https://zgilyhcsosvomeqjulpp.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_zCmHOoNBe6JelsWYetQByg_bWzRnEG0

# Payment gateway config (PRD Section 11 / payment module, Day 6).
# ---------------------------------------------------------------------------
# SECURITY: every VITE_ variable is bundled into the public JS bundle and is
# readable by anyone. Only client-safe values belong here — a merchant ID,
# a *publishable* API key, and redirect URLs. NEVER put a secret key or
# webhook secret in a VITE_ variable.
#
# Razorpay's Key Secret and Webhook Secret go here instead, once received —
# NEVER in this file:
#   supabase secrets set RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
#   supabase secrets set RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
#   supabase secrets set RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=... (from Project Settings > API)
# They are read only inside supabase/functions/* (Deno.env.get(...)), never
# by frontend code. See src/services/payment/payment.config.ts and
# supabase/README.md for full setup steps.
# ---------------------------------------------------------------------------

# "razorpay" (real payments), "mock" (simulated, no external dependency), or
# "bank" (placeholder for the client's own bank API, not yet implemented)
VITE_PAYMENT_PROVIDER=mock
# "sandbox" or "production" — cosmetic/logging only, Razorpay itself is
# switched between test/live mode by which Key ID you use (rzp_test_ vs rzp_live_)
VITE_PAYMENT_ENV=sandbox

# For Razorpay: paste the same Key ID here as RAZORPAY_KEY_ID above (the
# Key ID is safe client-side — it's the Key SECRET that must never be here).
VITE_PAYMENT_MERCHANT_ID=
VITE_PAYMENT_PUBLIC_KEY=
# Not used by Razorpay (checkout.js is loaded directly) — only relevant for
# a future "bank" provider with its own hosted gateway URL.
VITE_PAYMENT_GATEWAY_URL=

# These default sensibly to routes on this app — only override if the bank
# requires fully-qualified production URLs registered in advance.
VITE_PAYMENT_CALLBACK_URL=
VITE_PAYMENT_RETURN_URL=
VITE_PAYMENT_SUCCESS_URL=
VITE_PAYMENT_FAILURE_URL=

VITE_PAYMENT_CURRENCY=INR
